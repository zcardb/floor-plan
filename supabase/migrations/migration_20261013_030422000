CREATE TABLE public.interior_design_projects (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 100), schema_version integer NOT NULL DEFAULT 2 CHECK (schema_version = 2), state jsonb NOT NULL CHECK (jsonb_typeof(state) = 'object' AND jsonb_typeof(state->'walls') = 'array' AND jsonb_typeof(state->'furniture') = 'array' AND octet_length(state::text) <= 5000000), revision integer NOT NULL DEFAULT 0, created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now()); CREATE INDEX interior_projects_owner_updated ON public.interior_design_projects(owner_id, updated_at DESC); ALTER TABLE public.interior_design_projects ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_projects_select ON public.interior_design_projects FOR SELECT TO authenticated USING (auth.uid() = owner_id); CREATE POLICY interior_projects_insert ON public.interior_design_projects FOR INSERT TO authenticated WITH CHECK (auth.uid() = owner_id); CREATE POLICY interior_projects_update ON public.interior_design_projects FOR UPDATE TO authenticated USING (auth.uid() = owner_id) WITH CHECK (auth.uid() = owner_id); CREATE POLICY interior_projects_delete ON public.interior_design_projects FOR DELETE TO authenticated USING (auth.uid() = owner_id);

CREATE TABLE public.interior_furniture_catalog (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), catalog_id text NOT NULL, name text NOT NULL CHECK(char_length(name) BETWEEN 1 AND 100), category text NOT NULL, type text NOT NULL, width numeric NOT NULL CHECK(width BETWEEN 50 AND 20000), depth numeric NOT NULL CHECK(depth BETWEEN 50 AND 20000), height numeric NOT NULL CHECK(height BETWEEN 50 AND 8000), color text NOT NULL, price numeric CHECK(price BETWEEN 0 AND 100000000), image_url text, created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(owner_id,catalog_id)); ALTER TABLE public.interior_furniture_catalog ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_catalog_own ON public.interior_furniture_catalog FOR ALL TO authenticated USING(auth.uid()=owner_id) WITH CHECK(auth.uid()=owner_id);

CREATE TABLE public.interior_furniture_image_tasks (task_id text PRIMARY KEY, owner_id uuid NOT NULL DEFAULT auth.uid(), status text NOT NULL DEFAULT 'processing', created_at timestamptz NOT NULL DEFAULT now()); ALTER TABLE public.interior_furniture_image_tasks ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_image_tasks_read ON public.interior_furniture_image_tasks FOR SELECT TO authenticated USING(auth.uid()=owner_id);

create table public.interior_account_cost_defaults (owner_id uuid primary key default auth.uid(), settings jsonb not null default '{}'::jsonb check (jsonb_typeof(settings) = 'object'), revision integer not null default 0, updated_at timestamptz not null default now()); alter table public.interior_account_cost_defaults enable row level security; create policy interior_account_cost_own on public.interior_account_cost_defaults for all to authenticated using (auth.uid() = owner_id) with check (auth.uid() = owner_id);

create table public.interior_furniture_image_requests (owner_id uuid not null default auth.uid(), catalog_id uuid not null, task_id text, status text not null default 'submitting', created_at timestamptz not null default now(), primary key(owner_id,catalog_id)); alter table public.interior_furniture_image_requests enable row level security; create policy interior_image_requests_read on public.interior_furniture_image_requests for select to authenticated using (auth.uid()=owner_id);

alter table public.interior_furniture_catalog add column if not exists shape text;
alter table public.interior_furniture_catalog add constraint interior_catalog_shape_check check (shape is null or shape in ('reference','rectangle','circle'));

CREATE TABLE public.interior_furniture_image_regenerations (owner_id uuid NOT NULL DEFAULT auth.uid(), request_id uuid NOT NULL, catalog_id text NOT NULL, task_id text, status text NOT NULL DEFAULT 'submitting', created_at timestamptz NOT NULL DEFAULT now(), PRIMARY KEY (owner_id, request_id)); ALTER TABLE public.interior_furniture_image_regenerations ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_image_regenerations_read ON public.interior_furniture_image_regenerations FOR SELECT TO authenticated USING (auth.uid() = owner_id);