CREATE TABLE public.interior_furniture_catalog (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), catalog_id text NOT NULL, name text NOT NULL CHECK(char_length(name) BETWEEN 1 AND 100), category text NOT NULL, type text NOT NULL, width numeric NOT NULL CHECK(width BETWEEN 50 AND 20000), depth numeric NOT NULL CHECK(depth BETWEEN 50 AND 20000), height numeric NOT NULL CHECK(height BETWEEN 50 AND 8000), color text NOT NULL, price numeric CHECK(price BETWEEN 0 AND 100000000), image_url text, created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(owner_id,catalog_id)); ALTER TABLE public.interior_furniture_catalog ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_catalog_own ON public.interior_furniture_catalog FOR ALL TO authenticated USING(auth.uid()=owner_id) WITH CHECK(auth.uid()=owner_id); CREATE TABLE public.interior_furniture_image_tasks (task_id text PRIMARY KEY, owner_id uuid NOT NULL DEFAULT auth.uid(), status text NOT NULL DEFAULT 'processing', created_at timestamptz NOT NULL DEFAULT now()); ALTER TABLE public.interior_furniture_image_tasks ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_image_tasks_own ON public.interior_furniture_image_tasks FOR ALL TO authenticated USING(auth.uid()=owner_id) WITH CHECK(auth.uid()=owner_id);