CREATE TABLE public.interior_design_projects (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 100), schema_version integer NOT NULL DEFAULT 2 CHECK (schema_version = 2), state jsonb NOT NULL CHECK (jsonb_typeof(state) = 'object' AND jsonb_typeof(state->'walls') = 'array' AND jsonb_typeof(state->'furniture') = 'array' AND octet_length(state::text) <= 5000000), revision integer NOT NULL DEFAULT 0, created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now()); CREATE INDEX interior_projects_owner_updated ON public.interior_design_projects(owner_id, updated_at DESC); ALTER TABLE public.interior_design_projects ENABLE ROW LEVEL SECURITY; CREATE POLICY interior_projects_select ON public.interior_design_projects FOR SELECT TO authenticated USING (auth.uid() = owner_id); CREATE POLICY interior_projects_insert ON public.interior_design_projects FOR INSERT TO authenticated WITH CHECK (auth.uid() = owner_id); CREATE POLICY interior_projects_update ON public.interior_design_projects FOR UPDATE TO authenticated USING (auth.uid() = owner_id) WITH CHECK (auth.uid() = owner_id); CREATE POLICY interior_projects_delete ON public.interior_design_projects FOR DELETE TO authenticated USING (auth.uid() = owner_id);