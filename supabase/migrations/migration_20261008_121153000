CREATE TABLE public.interior_floor_catalog (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), floor_key text NOT NULL CHECK (floor_key ~* '^custom-[0-9a-f-]{36}$'), name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 100), pattern text NOT NULL CHECK (pattern IN ('plank','tile','seamless')), length numeric CHECK (length BETWEEN 50 AND 20000), width numeric CHECK (width BETWEEN 50 AND 20000), color text NOT NULL CHECK (color ~* '^#[0-9a-f]{6}$'), price numeric CHECK (price BETWEEN 0 AND 100000000), created_at timestamptz NOT NULL DEFAULT now(), UNIQUE (owner_id, floor_key), CHECK ((pattern = 'seamless' AND length IS NULL AND width IS NULL) OR (pattern <> 'seamless' AND length IS NOT NULL AND width IS NOT NULL)));
ALTER TABLE public.interior_floor_catalog ENABLE ROW LEVEL SECURITY;
CREATE POLICY interior_floor_catalog_own ON public.interior_floor_catalog FOR ALL TO authenticated USING (auth.uid() = owner_id) WITH CHECK (auth.uid() = owner_id);