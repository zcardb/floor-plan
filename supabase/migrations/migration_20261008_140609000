CREATE TABLE public.interior_wall_catalog (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), wall_key text NOT NULL CHECK (wall_key ~* '^custom-[0-9a-f-]{36}$'), name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 100), color text NOT NULL CHECK (color ~* '^#[0-9a-f]{6}$'), price numeric CHECK (price BETWEEN 0 AND 100000000), created_at timestamptz NOT NULL DEFAULT now(), UNIQUE (owner_id, wall_key));
ALTER TABLE public.interior_wall_catalog ENABLE ROW LEVEL SECURITY;
CREATE POLICY interior_wall_catalog_own ON public.interior_wall_catalog FOR ALL TO authenticated USING (auth.uid() = owner_id) WITH CHECK (auth.uid() = owner_id);
CREATE TABLE public.interior_opening_catalog (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id uuid NOT NULL DEFAULT auth.uid(), opening_key text NOT NULL CHECK (opening_key ~* '^custom-[0-9a-f-]{36}$'), name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 100), kind text NOT NULL CHECK (kind IN ('door','window')), width numeric NOT NULL CHECK (width BETWEEN 100 AND 10000), height numeric NOT NULL CHECK (height BETWEEN 100 AND 8000), price numeric CHECK (price BETWEEN 0 AND 100000000), created_at timestamptz NOT NULL DEFAULT now(), UNIQUE (owner_id, opening_key));
ALTER TABLE public.interior_opening_catalog ENABLE ROW LEVEL SECURITY;
CREATE POLICY interior_opening_catalog_own ON public.interior_opening_catalog FOR ALL TO authenticated USING (auth.uid() = owner_id) WITH CHECK (auth.uid() = owner_id);